{
  "name": "dsh-model-autofetch",
  "version": "0.1.0",
  "private": true,
  "description": "One-click model-list fetch for a provider's own endpoint in the DSH Models settings page: asks {baseURL}/models with the stored credential and merges new model ids into the provider's configuration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyansong760-byte/dsh-model-autofetch.git"
  },
  "homepage": "https://github.com/gongyansong760-byte/dsh-model-autofetch#readme",
  "bugs": {
    "url": "https://github.com/gongyansong760-byte/dsh-model-autofetch/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "models",
    "provider"
  ]
}